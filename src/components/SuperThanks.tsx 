import { useState } from 'react'
import { X, Heart, Send } from 'lucide-react'

interface Props {
  open: boolean
  onClose: () => void
  creator: string
}

export default function SuperThanks({ open, onClose, creator }: Props) {
  const [amount, setAmount] = useState<number | null>(5)
  const [custom, setCustom] = useState('')
  const [message, setMessage] = useState('')

  if (!open) return null

  const amounts = [1, 5, 10, 25]

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm animate-fade-in">
      <div className="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 animate-slide-up">
        <div className="flex items-center justify-between mb-4">
          <h2 className="text-xl font-bold text-gray-900 flex items-center gap-2">
            <Heart className="w-5 h-5 text-blue-600 fill-blue-600" /> Super Thanks
          </h2>
          <button onClick={onClose} className="p-1 hover:bg-gray-100 rounded-lg">
            <X className="w-5 h-5 text-gray-500" />
          </button>
        </div>

        <p className="text-sm text-gray-600 mb-4">
          Support <span className="font-semibold text-gray-900">{creator}</span> with a Super Thanks
        </p>

        <div className="grid grid-cols-4 gap-2 mb-4">
          {amounts.map(a => (
            <button 
              key={a} 
              onClick={() => { setAmount(a); setCustom('') }} 
              className={`py-3 rounded-lg font-semibold text-sm transition-all ${
                amount === a && !custom 
                  ? 'bg-blue-600 text-white shadow-md' 
                  : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
              }`}
            >
              ${a}
            </button>
          ))}
        </div>

        <div className="mb-4">
          <label className="text-xs font-medium text-gray-500 mb-1 block">Custom amount</label>
          <div className="relative">
            <span className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
            <input 
              type="number" 
              value={custom} 
              onChange={e => { setCustom(e.target.value); setAmount(null) }} 
              placeholder="Enter amount" 
              className="w-full pl-7 pr-4 py-2.5 bg-gray-100 border-0 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" 
            />
          </div>
        </div>

        <div className="mb-4">
          <label className="text-xs font-medium text-gray-500 mb-1 block">Add a message (optional)</label>
          <textarea 
            value={message} 
            onChange={e => setMessage(e.target.value)} 
            placeholder="Thanks for sharing this!" 
            rows={2} 
            className="w-full px-3 py-2.5 bg-gray-100 border-0 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none resize-none" 
          />
        </div>

        <button className="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg flex items-center justify-center gap-2 transition-colors shadow-md">
          <Send className="w-4 h-4" /> Send Super Thanks
        </button>
      </div>
    </div>
  )
}